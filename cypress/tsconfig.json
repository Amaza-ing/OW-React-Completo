{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [
      "cypress",
      "node",
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
